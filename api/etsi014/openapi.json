{
  "openapi": "3.1.0",
  "info": {
    "title": "TransEuroOGS KMS \u2014 initial ETSI 014 laboratory profile",
    "version": "0.1.0",
    "description": "Synthetic, same-node 256-bit profile. Not a certification of ETSI conformance. Ordered SAE associations and exactly-once recipient deliveries are enforced. Never automatically retry key delivery."
  },
  "servers": [
    {
      "url": "https://localhost:8443"
    }
  ],
  "security": [
    {
      "mutualTLS": []
    }
  ],
  "paths": {
    "/api/v1/keys/{slave_SAE_ID}/status": {
      "get": {
        "operationId": "get_status",
        "summary": "status",
        "parameters": [
          {
            "name": "slave_SAE_ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized SAE or association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable key material",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/keys/{slave_SAE_ID}/enc_keys": {
      "get": {
        "operationId": "get_enc_keys",
        "summary": "enc keys",
        "parameters": [
          {
            "name": "slave_SAE_ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "number",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "const": 256,
              "default": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyContainer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized SAE or association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable key material",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "post_enc_keys",
        "summary": "enc keys",
        "parameters": [
          {
            "name": "slave_SAE_ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyContainer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized SAE or association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable key material",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB"
          },
          "415": {
            "description": "JSON Content-Type required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/keys/{master_SAE_ID}/dec_keys": {
      "get": {
        "operationId": "get_dec_keys",
        "summary": "dec keys",
        "parameters": [
          {
            "name": "master_SAE_ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key_ID",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyContainer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized SAE or association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable key material",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "post_dec_keys",
        "summary": "dec keys",
        "parameters": [
          {
            "name": "master_SAE_ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyContainer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized SAE or association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable key material",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB"
          },
          "415": {
            "description": "JSON Content-Type required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyIDs"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTLS": {
        "type": "mutualTLS",
        "description": "TLS 1.3; verified URI SAN mapped to configured SAE"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "KeyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 1
          },
          "size": {
            "type": "integer",
            "const": 256,
            "default": 256
          },
          "additional_slave_SAE_IDs": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "string"
            }
          },
          "extension_mandatory": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "object"
            }
          },
          "extension_optional": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "KeyIDs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_IDs"
        ],
        "properties": {
          "key_IDs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key_ID"
              ],
              "properties": {
                "key_ID": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "key_ID_extension": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "KeyContainer": {
        "type": "object",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "required": [
                "key_ID",
                "key"
              ],
              "properties": {
                "key_ID": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "key": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "description": "32 bytes of synthetic material in this laboratory"
                }
              }
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "source_KME_ID",
          "target_KME_ID",
          "master_SAE_ID",
          "slave_SAE_ID",
          "key_size",
          "min_key_size",
          "max_key_size",
          "stored_key_count",
          "max_key_count",
          "max_key_per_request",
          "max_SAE_ID_count"
        ],
        "properties": {
          "source_KME_ID": {
            "type": "string"
          },
          "target_KME_ID": {
            "type": "string"
          },
          "master_SAE_ID": {
            "type": "string"
          },
          "slave_SAE_ID": {
            "type": "string"
          },
          "key_size": {
            "type": "integer",
            "const": 256
          },
          "min_key_size": {
            "type": "integer",
            "const": 256
          },
          "max_key_size": {
            "type": "integer",
            "const": 256
          },
          "stored_key_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "max_key_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "max_key_per_request": {
            "type": "integer",
            "const": 128
          },
          "max_SAE_ID_count": {
            "type": "integer",
            "const": 0
          }
        }
      }
    }
  }
}
